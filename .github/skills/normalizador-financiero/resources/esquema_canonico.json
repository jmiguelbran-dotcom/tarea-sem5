{
  "schema_version": "2.0.0",
  "campos_obligatorios": [
    "id_transaccion",
    "fuente",
    "monto",
    "moneda",
    "estado",
    "fecha",
    "es_valida"
  ],
  "clasificacion_divisas": {
    "FIAT": ["USD", "EUR", "GBP", "JPY", "MXN", "SVC"],
    "CRYPTO": ["BTC", "ETH", "SOL", "USDC"]
  },
  "invariantes_contables": {
    "formato_monto_regex": "^\\d+\\.\\d{2}$",
    "formato_fecha_regex": "^\\d{4}-\\d{2}-\\d{2}$",
    "estados_permitidos": ["COMPLETADO", "PENDIENTE", "FALLIDO"]
  }
}